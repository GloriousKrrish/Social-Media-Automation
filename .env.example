# Environment Configuration Template
ENVIRONMENT=development
DEBUG=True

# Database Configuration (Local or Supabase Postgres)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=socialpilot_db
SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/socialpilot_db

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=socialpilot-assets

# Cache & Redis
REDIS_URL=redis://localhost:6379/0

# Security & JWT
SECRET_KEY=ENTERPRISE_PRODUCTION_SECRET_KEY_CHANGE_ME_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend API Endpoint & Supabase Config
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

